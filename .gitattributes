# Auto-detect text files and normalize line endings
* text=auto

# Source code and text files
*.cpp text diff=cpp
*.c text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp
*.vs text
*.fs text
*.glsl text
*.txt text
*.md text
*.json text
*.xml text
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.sln text eol=crlf
.gitignore text
.gitattributes text

# Binary media and asset files (prevent CRLF conversion and corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tif binary
*.tiff binary
*.bmp binary
*.tga binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.ttf binary
*.otf binary
*.obj binary
*.fbx binary
*.blend binary
*.mtl binary
*.dae binary
*.dll binary
*.lib binary

